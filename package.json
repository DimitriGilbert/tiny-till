    "zod": "^4.1.13",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tiny-till/config": "*",
    "@types/html2canvas": "^0.5.35",
    "gh-pages": "^6.3.0",
    "turbo": "^2.6.3",
    "typescript": "^5",
    "vite-plugin-compression": "^0.5.1"
  },
  "packageManager": "npm@11.6.2"
