{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "serve": "vite preview",
    "start": "vite",
    "check-types": "tsc --noEmit",
    "validate:build": "tsx scripts/validate-build.ts",
    "generate-icons": "tsx scripts/generate-icons.ts",
    "deploy": "npm run build && gh-pages -d dist --cname tiny-till.dbuild.dev --dotfiles",
    "test": "playwright test",
    "test:component": "playwright test tests/examples/product-card.spec.ts",
    "test:integration": "playwright test tests/examples/catalog-flow.spec.ts tests/examples/tally-flow.spec.ts",
    "test:e2e": "playwright test tests/examples/user-onboarding.spec.ts",
    "test:all": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "test:mobile": "playwright test --project=chrome-mobile-portrait --project=chrome-iphone-se --project=chrome-iphone-14 --project=firefox-android",
    "test:desktop": "playwright test --project=chromium-desktop --project=firefox-desktop --project=webkit-desktop",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:report": "tsx scripts/generate-report.ts",
    "test:aggregate": "tsx scripts/aggregate-results.ts",
    "test:edge-cases": "playwright test tests/edge-cases",
    "test:edge:storage": "playwright test tests/edge-cases/storage-quota.spec.ts",
    "test:edge:corrupted": "playwright test tests/edge-cases/corrupted-files.spec.ts",
    "test:edge:network": "playwright test tests/edge-cases/network-failures.spec.ts",
    "test:edge:concurrent": "playwright test tests/edge-cases/concurrent-actions.spec.ts",
    "test:edge:recovery": "playwright test tests/edge-cases/recovery-flows.spec.ts",
    "test:regression": "playwright test tests/regression/edge-case-regression.spec.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@hookform/resolvers": "^5.1.1",
    "@tailwindcss/vite": "^4.0.15",
    "@tanstack/react-form": "^1.12.3",
    "@tanstack/react-router": "^1.141.1",
    "@tanstack/react-virtual": "^3.13.18",
    "@tiny-till/env": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "highlight.js": "^11.11.1",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.473.0",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^3.6.2",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.2.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tanstack/react-router-devtools": "^1.141.1",
    "@tanstack/router-plugin": "^1.141.1",
    "@tiny-till/config": "*",
    "@types/node": "^22.13.14",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "postcss": "^8.5.3",
    "sharp": "^0.33.0",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vite": "^6.2.2",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0"
  }
}
